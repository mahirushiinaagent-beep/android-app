{
  "name": "alisa",
  "version": "11.1.1-voice-model-test",
  "description": "ALISA — voice assistant PWA with a small Node.js server (PostgreSQL/Neon or JSON-file memory storage)",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "setup:voice": "node setup-voice-models.js",
    "test": "node --test --test-force-exit \"test/*.test.js\"",
    "setup:semantic": "node setup-embedding-model.js",
    "test:browser": "python3 test/pin.test.py . code && python3 test/agent-ui.test.py ."
  },
